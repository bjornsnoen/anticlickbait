{
  "name": "Anti-clickbait",
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "version": "1.0.0",
  "description": "Shows you the real title of an article before you click it on VG.no",
  "manifest_version": 3,
  "background": {
    "{{firefox}}.scripts": ["src/background/index.ts"],
    "{{chrome}}.service_worker": "src/background/index.ts",
    "{{chrome}}.type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vg.no/*"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "action": {
    "default_title": "Reveal clickbait",
    "default_icon": {
      "16": "img/logo-16.png",
      "32": "img/logo-32.png",
      "48": "img/logo-48.png",
      "64": "img/logo-64.png",
      "128": "img/logo-128.png"
    }
  },
  "permissions": ["contextMenus", "storage"],
  "options_ui": {
    "page": "pages/options.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{1d72d1ac-c3d9-4411-9322-f12e9284ede2}",
      "strict_min_version": "121.0"
    }
  }
}
